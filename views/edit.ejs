<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Entry | RosyPages</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Dancing+Script:wght@600;700&family=Poppins:wght@400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/quill@1.3.7/dist/quill.snow.css">
    <link rel="stylesheet" href="/style.css">
</head>
<body class="write-bg">

    <%- include("partials/navbar") %>

    <%
        const dt = diary.created_at;
        const dateValue = dt.getFullYear() + "-" +
            String(dt.getMonth() + 1).padStart(2, "0") + "-" +
            String(dt.getDate()).padStart(2, "0");
        const base = "/diaries/" + journal._id + "/entries/" + diary._id;
    %>

    <form class="write-paper" id="editForm" method="POST" action="<%= base %>?_method=PUT">

        <div class="write-top">
            <input class="write-title" type="text" name="title" value="<%= diary.title %>"
                   placeholder="Entry Title" maxlength="100" required>

            <div class="top-right">
                <button class="save-now" type="submit">Update now ✨</button>
                <button class="fmt-toggle" type="button" id="fmtToggle" title="Formatting">A</button>
            </div>
        </div>

        <div class="write-meta">
           <div class="meta-left">
    <label class="date-box">
        📅 <input type="date" name="created_at" id="entryDate" value="<%= dateValue %>" required>
    </label>
    <span class="word-count" id="wordCount">0 words</span>
</div>

            <div class="meta-right">
               <a href="<%= base %>" class="back-link">← Back to this page</a>

                <button class="menu-btn" type="button" id="menuBtn" title="More options">⋯</button>
                <div class="menu-list" id="menuList">
                    <button class="menu-item" type="button" id="printBtn">🖨 Print</button>
                    <a class="menu-item" href="<%= base %>/export?format=txt">⬇ Export as text (.txt)</a>
                    <a class="menu-item" href="<%= base %>/export?format=html">⬇ Export as web page (.html)</a>
                    <div class="menu-sep"></div>
                    <button class="menu-item danger" type="button" id="deleteBtn">🗑 Delete entry</button>
                </div>
            </div>
        </div>

        <div class="edit-editor" id="editorBox">
            <div id="editor"></div>
        </div>

        <input type="hidden" name="content" id="content">
        <textarea id="initialContent" style="display:none"><%= diary.content %></textarea>

    </form>

    <!-- Delete ke liye alag form (form ke andar form nahi ban sakta) -->
    <form id="deleteForm" method="POST" action="<%= base %>?_method=DELETE"></form>

    <script src="https://cdn.jsdelivr.net/npm/quill@1.3.7/dist/quill.min.js"></script>
    <script>
        const quill = new Quill("#editor", {
            theme: "snow",
            placeholder: "Dear diary... 🌸",
            modules: {
                toolbar: [
                    [{ size: ["small", false, "large", "huge"] }, { header: [1, 2, 3, false] }],
                    ["bold", "italic", "underline", "strike"],
                    [{ color: [] }, { background: [] }],
                    [{ list: "ordered" }, { list: "bullet" }],
                    [{ align: [] }],
                    ["clean"]
                ]
            }
        });

        quill.root.innerHTML = document.getElementById("initialContent").value;
        // live word count
const wordCount = document.getElementById("wordCount");
function countWords() {
    const text = quill.getText().trim();
    const n = text ? text.split(/\s+/).length : 0;
    wordCount.textContent = n + (n === 1 ? " word" : " words");
}
quill.on("text-change", countWords);
countWords();

        // "A" button se toolbar kholo ya band karo
        const box = document.getElementById("editorBox");
        const toggleBtn = document.getElementById("fmtToggle");
        toggleBtn.addEventListener("click", () => {
            box.classList.toggle("show-toolbar");
            toggleBtn.classList.toggle("active");
        });

        // calendar
        const dateInput = document.getElementById("entryDate");
        dateInput.addEventListener("click", () => {
            if (dateInput.showPicker) dateInput.showPicker();
        });

        // ⋯ menu
        const menuBtn = document.getElementById("menuBtn");
        const menuList = document.getElementById("menuList");

        function closeMenu() {
            menuList.classList.remove("open");
            menuBtn.classList.remove("active");
        }

        menuBtn.addEventListener("click", (e) => {
            e.stopPropagation();
            menuList.classList.toggle("open");
            menuBtn.classList.toggle("active");
        });
        document.addEventListener("click", closeMenu);
        document.addEventListener("keydown", (e) => { if (e.key === "Escape") closeMenu(); });

        // Print
        document.getElementById("printBtn").addEventListener("click", () => {
            closeMenu();
            window.print();
        });

        // Delete
        document.getElementById("deleteBtn").addEventListener("click", () => {
            closeMenu();
            if (confirm("Are you sure you want to delete this entry?")) {
                document.getElementById("deleteForm").submit();
            }
        });

        // submit se pehle content hidden input mein daalo
        document.getElementById("editForm").addEventListener("submit", function () {
            document.getElementById("content").value = quill.root.innerHTML;
        });
    </script>

</body>
</html>