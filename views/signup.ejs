<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sign Up | RosyPages</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Dancing+Script:wght@600;700&family=Poppins:wght@400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/style.css">
</head>
<body class="home-body">

    <%- include("partials/navbar") %>

    <div class="auth-card">
        <h2>Create your diary 🌸</h2>
        <p class="auth-sub">Start your private, pretty online diary for free.</p>
        <p class="auth-sub">Already have an account? <a href="/signin">Sign in here.</a></p>

        <form method="POST" action="/signup">
            <label for="name">Name</label>
            <input type="text" id="name" name="name" placeholder="Your name" required>

            <label for="email">Email</label>
            <input type="email" id="email" name="email" placeholder="eg. you@example.com" required>

            <label for="password">Password</label>
            <input type="password" id="password" name="password" placeholder="Create a password" minlength="6" required>

            <button class="auth-btn">Sign Up</button>
        </form>
    </div>

</body>
</html>