<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sign In | RosyPages</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Dancing+Script:wght@600;700&family=Poppins:wght@400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/style.css">
</head>
<body class="home-body">

    <%- include("partials/navbar") %>

    <div class="auth-card">
        <h2>Welcome back 🌷</h2>
        <p class="auth-sub">Enter your email and password to open your RosyPages diary.</p>
        <p class="auth-sub">Don't have an account? <a href="/signup">Sign up here.</a></p>

        <form method="POST" action="/signin">
            <label for="email">Email</label>
            <input type="email" id="email" name="email" placeholder="eg. you@example.com" required>

            <label for="password">Password</label>
            <input type="password" id="password" name="password" placeholder="Enter your password" required>

            <button class="auth-btn">Sign In</button>
        </form>
    </div>

</body>
</html>